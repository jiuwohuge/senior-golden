# =============================================================================
# Senior Golden / Senior Post — 环境变量模板
# =============================================================================
# 用法：
#   1. 复制本文件为仓库根目录 .env（已 gitignore，勿提交密钥）
#        copy .env.example .env
#   2. 按需填写；Docker Compose 会自动读取根目录 .env 并注入各服务
#   3. 改完后需 recreate 相关容器，例如：
#        .\scripts\dev-up.ps1 -ApiOnly
#
# 说明：
#   - 下列变量均由「根目录 docker-compose.yml」消费（或透传进容器）
#   - 标注「→」的是容器内 Spring / Vite 实际读取点
#   - Flutter App 不读根目录 .env（见文末「非 .env」说明）
# =============================================================================


# -----------------------------------------------------------------------------
# 基础设施端口与数据目录（docker-compose：nginx / postgresql / redis）
# -----------------------------------------------------------------------------

# nginx 宿主机映射端口（compose: nginx.ports）
NGINX_PORT=80

# nginx 配置目录挂载到容器 /etc/nginx/conf.d/
# 使用处：docker-compose.yml → nginx.volumes
NGINX_CONFIG_DIR=D:/06_docker_workplace/nginx/conf.d

# Postgres 宿主机端口（本机连库常用 65432；容器内仍是 5432）
# 使用处：docker-compose.yml → postgresql.ports
POSTGRES_PORT=65432

# Postgres 库名 / 用户 / 密码（Bitnami 镜像环境变量）
# 使用处：docker-compose.yml → postgresql.environment
# 注意：须与下方 SPRING_DATASOURCE_* 一致，否则 API 连不上库
POSTGRES_DB=senior_post
POSTGRES_USER=postgres
POSTGRES_PASSWORD=myppost@2026

# Postgres 数据目录（宿主机路径）
# 使用处：docker-compose.yml → postgresql.volumes
POSTGRES_DATA_DIR=D:/06_docker_workplace/postgresql

# Redis 宿主机端口与数据目录
# 使用处：docker-compose.yml → redis.ports / redis.volumes
REDIS_PORT=6379
REDIS_DATA_DIR=D:/06_docker_workplace/redis-data


# -----------------------------------------------------------------------------
# senior-post-api（Compose 注入 → Spring Boot）
# -----------------------------------------------------------------------------

# Spring Profile
# 使用处：compose → SPRING_PROFILES_ACTIVE
#         → application.yml spring.profiles.active（默认 local）
SPRING_PROFILES_ACTIVE=local

# HTTP context-path
# 使用处：compose → SERVER_SERVLET_CONTEXT_PATH
#         → application.yml server.servlet.context-path（默认 /backend）
# 对外完整地址示例：http://localhost:9011/backend 或经 nginx http://localhost/backend
SERVER_SERVLET_CONTEXT_PATH=/backend

# 数据源（容器内连 compose 网络中的 postgresql 服务名）
# 使用处：compose → SPRING_DATASOURCE_*
#         → 覆盖 application-local.yml 中的 spring.datasource.*
# 本机若不用 Compose、直接连宿主机库，URL 可改为：
#   jdbc:postgresql://127.0.0.1:65432/senior_post?...
SPRING_DATASOURCE_URL=jdbc:postgresql://postgresql:5432/senior_post?useunicode=true&useSSL=false&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=myppost@2026

# Redis（容器内连 redis 服务名）
# 使用处：compose → SPRING_DATA_REDIS_*
#         → 覆盖 application-local.yml spring.data.redis.*
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# JVM / 远程调试（5005 已在 compose 映射）
# 使用处：compose → JAVA_OPTS → 容器启动参数
JAVA_OPTS=-Xms256m -Xmx512m -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005


# -----------------------------------------------------------------------------
# 阿里云 OSS（发信附图 / 头像等直传签名）
# -----------------------------------------------------------------------------
# 使用处：compose → ALIYUN_OSS_*
#         → application.yml senior-post.oss.*
#         → AppOssController / OssDisplayUrlService 等
# 未配齐四项时，/api/oss/put-sign 会返回业务错误提示
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
# 可选：公网访问基址（无协议或带 https 均可，按现有 OSS 配置约定）
ALIYUN_OSS_PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# 百度图像机审（明信片 / 头像等图片审核，Baidu AIP SDK，非 Spring AI）
# -----------------------------------------------------------------------------
# 使用处：compose → MODERATION_BAIDU_*
#         → application.yml senior-post.moderation.baidu.*
#         → Baidu 图像审核 Provider / 补偿任务
MODERATION_BAIDU_APP_ID=
MODERATION_BAIDU_API_KEY=
MODERATION_BAIDU_API_SECRET=


# -----------------------------------------------------------------------------
# Spring AI + DeepSeek（文本机审 + 信件助手；统一 ChatModel）
# -----------------------------------------------------------------------------
# 使用处：compose → SPRING_AI_* / SPRING_AI_DEEPSEEK_*
#         → application.yml spring.ai.deepseek.*
#         → application.yml senior-post.moderation.deepseek.*（管理端「凭证就绪」探测同源）
#         → DeepSeekTextModerationProvider / LetterAssistantService
#
# SPRING_AI_MODEL_CHAT：
#   - none     ：不装配 ChatModel（无 key 时推荐，避免启动失败）
#   - deepseek ：启用 DeepSeek Chat（须配置下方 API KEY）
SPRING_AI_MODEL_CHAT=none
SPRING_AI_DEEPSEEK_API_KEY=
SPRING_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
SPRING_AI_DEEPSEEK_MODEL=deepseek-v4-flash


# -----------------------------------------------------------------------------
# 认证 / 邮件（可选）
# -----------------------------------------------------------------------------
# Google Web Client ID（App OAuth / 服务端校验）
# 使用处：compose → GOOGLE_WEB_CLIENT_ID
#         → application.yml senior-post.oauth.google.client-id
GOOGLE_WEB_CLIENT_ID=

# 密码重置 pepper（生产务必改成随机串）
# 使用处：compose → PASSWORD_RESET_PEPPER
#         → application.yml senior-post.auth.password-reset-pepper
PASSWORD_RESET_PEPPER=

# 系统发信 From（需同时配置 spring.mail.* 才会真发邮件；否则验证码打 WARN 日志）
# 使用处：compose → SENIOR_POST_MAIL_FROM
#         → application.yml senior-post.mail.from
SENIOR_POST_MAIL_FROM=


# -----------------------------------------------------------------------------
# senior-post-manage（Vite 管理端，Compose 服务）
# -----------------------------------------------------------------------------
# 使用处：compose → senior-post-manage.environment
#         → senior-post-manage/vite.config.ts（VITE_BASE_PATH）
#         → 前端 API 基址（VITE_API_BASE_URL，通常指向 nginx 反代的 /backend）
VITE_API_BASE_URL=http://localhost/backend
VITE_BASE_PATH=/manage/


# =============================================================================
# 非根目录 .env（勿写进本文件指望 Compose 注入）
# =============================================================================
# Flutter（senior-post-flutter）使用编译期 --dart-define，例如：
#   API_BASE_URL          → lib/core/config/api_base_url.dart
#   GOOGLE_SERVER_CLIENT_ID / 等同 → lib/core/auth/google_sign_in_facade.dart
#   JH_AES_KEY            → lib/core/network/jh_api_crypto.dart
# 本地运行见 senior-post-flutter/README.md、scripts/flutter-run-*.ps1
# =============================================================================
